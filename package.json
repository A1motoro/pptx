{
  "name": "pptx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "slidev deck-1.md --open",
    "dev:1": "slidev deck-1.md --open",
    "dev:2": "slidev deck-2.md --open",
    "dev:3": "slidev deck-3.md --open",
    "build": "node scripts/build-decks.mjs",
    "build:1": "slidev build deck-1.md --out dist/1 --base /pptx/1/",
    "build:2": "slidev build deck-2.md --out dist/2 --base /pptx/2/",
    "build:3": "slidev build deck-3.md --out dist/3 --base /pptx/3/",
    "export": "slidev export deck-1.md"
  },
  "dependencies": {
    "@slidev/cli": "^52.10.1",
    "@slidev/theme-apple-basic": "^0.25.1",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "vue": "^3.5.25"
  }
}
