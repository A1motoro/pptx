{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/1/:path*", "destination": "/1/index.html" },
    { "source": "/2/:path*", "destination": "/2/index.html" },
    { "source": "/3/:path*", "destination": "/3/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
